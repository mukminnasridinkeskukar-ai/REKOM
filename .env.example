# ==============================================================
# E-REKOM — Environment Variables
# --------------------------------------------------------------
# Salin file ini menjadi .env lalu isi sesuai mode yang dipakai.
#   cp .env.example .env
#
# MODE DEMO (tanpa Supabase): biarkan variabel Supabase kosong.
#   Aplikasi otomatis memakai SQLite + data contoh lengkap
#   (8 jenis rekomendasi, akun tiap role, 8 pengajuan contoh).
# ==============================================================

# --- Database lokal (Mode Demo / SQLite) -----------------------
# Dibuat otomatis oleh: bun run db:push
DATABASE_URL="file:./db/custom.db"

# --- Supabase (Mode Produksi) ----------------------------------
# Isi KEDUA variabel di bawah untuk mengaktifkan Supabase
# (Auth + Postgres RLS + Storage + Realtime). Mode demo nonaktif
# otomatis ketika keduanya terisi.
# Salin dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Opsional — service role key untuk render PDF publik via QR
# (halaman /verifikasi/[id] mengunduh surat resmi).
# JANGAN pernah memakai key ini di sisi klien!
SUPABASE_SERVICE_ROLE_KEY=""

# --- URL aplikasi ----------------------------------------------
# Dipakai untuk tautan QR verifikasi pada PDF surat terbit,
# mis. https://erekom.dinkes.kukarkab.go.id
NEXT_PUBLIC_APP_URL="http://localhost:3000"
